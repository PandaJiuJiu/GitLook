[Unit]
Description=Minisite - Lightweight self-hosted static site hosting with Git push deployment
After=network.target

[Service]
Type=simple
User=minisite
Group=minisite
WorkingDirectory=/var/lib/minisite
ExecStart=/usr/local/bin/minisite-server --config /etc/minisite/config.toml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minisite /var/log/minisite
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
